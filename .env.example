# Copy to .env and fill in. Never commit .env.

# Modal (https://modal.com/settings)
# MODAL_TOKEN_ID=
# MODAL_TOKEN_SECRET=

# Hugging Face (model downloads)
# HF_TOKEN=

# Weights & Biases — eval metrics logged per run_trial call
# Get your key at https://wandb.ai/settings
# WANDB_API_KEY=
# WANDB_PROJECT=vla-memory-new   (default if unset)
